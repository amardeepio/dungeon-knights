# Environment template. Copy to `.env.local` and fill in. Never commit a filled copy.
#
#     cp .env.example .env.local
#
# `.env.local` is gitignored and excluded from Vercel uploads (`.vercelignore`), which matters here:
# this project holds a deployer key and a funded game signer. Next.js loads `.env`,
# `.env.local`, `.env.production` and `.env.production.local` — it does NOT read this file, so
# leaving it in the repo cannot shadow a dashboard variable on a deploy.
#
# Every name below is read by the code; none is aspirational. Where the code has a default it is
# quoted, so you only need a line when you want to differ from it. Where it has none, the
# consequence of leaving it blank is stated — that is the part a template cannot guess.
#
# The secrets fall into three groups, and the difference matters in production:
#   1. Session/HMAC secrets (POINTS_SESSION_SECRET and the two that derive from it). Unset in
#      production, each generates a random per-process secret and logs a warning — which invalidates
#      every session and every signed payload on each deploy and on each serverless cold start.
#   2. The funded signer (GAME_SIGNER_PRIVATE_KEY). Unset means no run is ever signed, so the game
#      cannot pay out. There is deliberately no fallback.
#   3. Third-party credentials (Privy, Discord, X, Upstash, Vercel). Blank means that integration
#      reports itself unconfigured and the page degrades to its documented fallback.


# ─────────────────────────────────────────────────────────────── hosts and the Kingdom Gate
# The public host. Comma-separated; the middleware treats these as the apex and does not gate them.
APEX_HOSTS=dungeonknights.io,www.dungeonknights.io
# The game host. Gated when APP_GATE_PASSWORD is set, and only then.
APP_HOSTS=app.dungeonknights.io

# Blank means NOTHING is gated — the game is world-readable. Set it before any public deploy.
# This is a shared human password, not a token; it is also the fallback secret material for
# APP_GATE_SECRET, so changing it invalidates outstanding gate cookies.
APP_GATE_PASSWORD=
# Signs the gate cookie. Unset derives from APP_GATE_PASSWORD; blank with no password gates nothing.
APP_GATE_SECRET=


# ────────────────────────────────────────────────────────────────────────────── the chain
# Robinhood Chain testnet. The defaults below are the testnet values; switch all of these together.
GAME_CHAIN_ID=46630
GAME_RPC_URL=https://rpc.testnet.chain.robinhood.com
GAME_EXPLORER_URL=https://explorer.testnet.chain.robinhood.com
# The block the game was deployed in, used to bound log scans. Unset falls back to a per-address
# table in `lib/chain-logs.js`; set it if you deploy a new contract and want a hard floor.
GAME_FROM_BLOCK=
# How far back a log scan may reach when no floor applies. Default 1000000.
GAME_LOOKBACK_BLOCKS=
# Floor and ceiling on how long a run may take, in seconds. Defaults 300 and 30. These are the
# anti-cheat bounds: a run faster than the floor is rejected as too good to be true.
GAME_MIN_BASE_SECONDS=
GAME_MIN_FLOOR_SECONDS=
# How long a signed run receipt stays valid, in seconds. Default 900.
GAME_RECEIPT_TTL_SECONDS=


# ───────────────────────────────────────────────────────────────── deployed contract addresses
# Public on-chain data, not secrets. The defaults are the currently deployed testnet addresses;
# uncomment to pin them, which is worth doing on a machine that also holds a signer key.
# The contract that pays out. No default: blank means the game has no V4 to talk to.
GAME_CONTRACT_V4=
# The previous version, kept for runs already signed against it.
# GAME_CONTRACT_V3=0xD8de9385Db7DfE925882E76849B6e067e47236e5
# DNG_TOKEN_ADDRESS=0x3D94e56E0d967633830f6d9E42CE43A64FFfD6
# KNIGHT_NFT_ADDRESS=0x27Cfbb763188a50Fe1C0fFfBe2552b1945eE1B
# The pool every genesis knight was staked into. Falls back to STAKING_CONTRACT when blank.
GENESIS_NFT=
GENESIS_STAKING=
# The staking pool for minted knights. No default.
KNIGHTS_STAKING=
# Where rewards are paid from. No default: blank and the payout path is off.
REWARD_VAULT=
STAKING_CONTRACT=
RAFFLE_CONTRACT=
# DNG per week, and the DNG the staking pool is denominated in. Blank falls back to the on-chain
# line budget in `app/api/staking/config/route.js`.
WEEKLY_POOL_DNG=
KNIGHTS_POOL_DNG=


# ──────────────────────────────────────────────────────────────────────── signing a run
# THE ONE SECRET THAT MOVES MONEY. The account that signs run receipts the paying contract accepts.
# It must be funded for gas. There is no fallback and no default: blank means nothing is signed, so
# no run can be paid. Keep it out of git, out of Vercel, and out of shell history.
GAME_SIGNER_PRIVATE_KEY=
# Signs a run request end to end. Unset derives from POINTS_SESSION_SECRET; in production, unset
# means run submission is refused outright.
GAME_RUN_SECRET=


# ──────────────────────────────────────────────────────────────────────── session secrets
# HMAC key for Points sessions. Unset in production generates a random per-process secret and warns,
# which logs every player out on every cold start. Set it to a long random string and keep it.
POINTS_SESSION_SECRET=
# Capsule claim signing key. Unset derives from POINTS_SESSION_SECRET prefixed with `capsules:`.
CAPSULE_CLAIM_SECRET=
# Bearer token for the scheduled draws. Blank refuses the cron route, which is the safe default.
CRON_SECRET=


# ─────────────────────────────────────────────────────────────────────────── point store
# Two interchangeable backends, both Upstash-shaped REST. With neither pair set, development uses
# a file driver under `.data/` — so the Points Program runs locally with no configuration at all,
# and loses its data when that directory does.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=


# ─────────────────────────────────────────────────────────────────────────────────────── Privy
# Public identifiers, safe in the client bundle — they name the app to Privy's hosted components.
# With PRIVY_APP_ID blank the provider does not mount at all, the wallet falls back to an injected
# extension, and `app/privy-gate.js` skips the SDK entirely (which is why the apex ships ~660 KB
# instead of ~18 MB of JavaScript).
PRIVY_APP_ID=
PRIVY_CLIENT_ID=


# ────────────────────────────────────────────────────────────────────────────────────── Discord
# The bot behind the slash commands. DISCORD_PUBLIC_KEY is the Ed25519 application public key used
# to verify every inbound interaction signature — get it wrong and every command is rejected.
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_GUILD_ID=
# How long an interaction may take before it is deferred. Unset uses the Discord default.
DISCORD_INTERACTION_DEADLINE_MS=
# Whether the activity presence shows player handles. Off unless exactly `true` — this one is a
# privacy switch, so it fails closed.
DISCORD_ACTIVITY_SHOW_HANDLES=


# ──────────────────────────────────────────────────────────────────────────────────── X
# Consumer credentials for the Points Program's X integration. All blank means the X tasks report
# themselves unavailable rather than failing a player mid-flow.
# X_API_KEY=
# X_ACCESS_TOKEN=
# X_ACCESS_TOKEN_SECRET=
# X_BEARER_TOKEN=
# X_CONSUMER_KEY=
# X_CONSUMER_SECRET=
# Public webhook endpoint X posts follow events to. Blank disables the follow check.
# X_WEBHOOK_URL=
# The numeric user id the campaign follows, not the handle. A renamed handle keeps its id, so this
# survives a rename; a handle would not.
X_FOLLOW_TARGET_ID=
# `webhook` enables proof via the webhook above. Anything else disables it.
FOLLOW_PROOF_MODE=
# The handle every share must tag. Default DNGrobinhood; a leading @ is stripped.
X_SHARE_TAG=
# The post new shares are asked to quote.
X_CAMPAIGN_POST=
# The keyword a campaign post must contain to count.
X_CAMPAIGN_KEYWORD=
# Payouts, in whole DNG. Both default to 500.
X_QUOTE_REWARD=
X_ENGAGEMENT_REWARD=
# The date the program opened, YYYY-MM-DD. Default 2026-09-23. Rewards are dated from it, so
# changing it re-bases every window that has already been paid.
X_PROGRAM_DAY_ONE=


# ──────────────────────────────────────────────────────────────────────────── Points Program
# Minimum points before a referral can be paid. Default 10.
REFERRAL_MIN_POINTS=
# Days a capsule claim stays open. Default 1.
CAPSULE_CLAIM_WINDOW_DAYS=
# The Google Form the capsule claim sends players to. Default is the live form; override to close
# the programme by pointing it somewhere inert.
CAPSULE_FORM_URL=
# The waitlist form's embed. Set to `true` to hide it without deleting the markup.
WAITLIST_FORM_DISABLED=
WAITLIST_FORM_ENTRY=
# The date the giveaway opened, YYYY-MM-DD. Blank means no giveaway is running.
GIVEAWAY_DAY_ONE=
CAPSULE_NFT=


# ───────────────────────────────────────────────────────────────────────────────────── site
# Read by the browser as well as the server, so it is the one value here that reaches the client.
NEXT_PUBLIC_SITE_URL=https://dungeonknights.vercel.app


# ─────────────────────────────────────────────────────────────────────────── tools only
# None of these are read by the running site. They are here because a variable the app ignores is
# indistinguishable from one that has been renamed, and a checker that silently stops testing
# something is worse than a checker that fails.
#
# The base URL `tools/check-gate.js` drives the live site at, when you want it to check a
# deployment instead of your own machine. Default http://127.0.0.1:3000.
PREVIEW_URL=
# The gate password as it is set in PRODUCTION. Only ever set this to point the checker at a live
# host, and only on a machine you trust: it is a real credential for a real deploy.
APP_GATE_LIVE_PASSWORD=
# The deployer key, read by the one-off scripts at the repo root (`redeploy-game-contract.js`,
# `fix-nft-address.js`, `test-claim-simulation.js`). This is the key `.vercelignore` is protecting
# when it excludes `.env.local` — a funded signer, not a placeholder. Note the name differs from
# `GAME_SIGNER_PRIVATE_KEY` on purpose: those are two different keys for two different jobs, and
# conflating them is how a test script ends up able to move money.
PRIVATE_KEY=
# Accepted by `tools/check-staking-chain.js` as an override for KNIGHT_NFT_ADDRESS. There is
# already a canonical singular name for that address; set this one only if a checker told you to.
KNIGHTS_NFT_ADDRESS=

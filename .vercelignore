# Never upload local secrets or machine state to a deployment.
# (.env.local holds a deployer private key and the local VERCEL_OIDC_TOKEN; a Next.js
# build on Vercel would otherwise read it and could shadow the dashboard's own vars.)
.env
.env.local
.env.production
.env*.local
private-key.txt
*.key
*.pem

# Local-only state: the file-driver point store and Freebuff scratch/logs.
/.data/
/.freebuff/

# Source art and build tooling are not part of the deployed site — everything the
# browser fetches lives under public/ (e.g. public/assets/points/, public/sprites/).
#
# Every pattern below is ANCHORED with a leading slash on purpose. An unanchored
# `points/` also matches `app/points/`, `app/api/points/` and `public/assets/points/`,
# which silently stripped the whole Points Program out of a deployment: the route 404'd
# and the vault had no art, while the build itself succeeded and looked fine.
/art/
/arya/
/points/
/tools/
/docs/
# The source-art trees, whose served copies all live under public/. The six
# assets/ui/*.png files that tools/extract-sprites.js still reads as build
# inputs are the only reason any of this needs to exist on disk.
/assets/
/maps/
